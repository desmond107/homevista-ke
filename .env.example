# ─── Core ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/homevista_ke"
# Public base URL, no trailing slash. Must be public HTTPS in production (M-Pesa callbacks, emails, sitemap).
APP_URL="http://localhost:3000"
# Long random string: `openssl rand -hex 32`. Used for OTP hashing and visitor hashing.
AUTH_SECRET=""
# Protects GET /api/cron (hourly reminders, alerts, cleanup): `openssl rand -hex 16`
CRON_SECRET=""

# ─── M-Pesa Daraja (STK Push) ───────────────────────────
# simulate | sandbox | production   (simulate needs no credentials; shows a "simulated phone" in the modal)
MPESA_MODE="simulate"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""            # Paybill / HO number (sandbox: 174379)
MPESA_PASSKEY=""              # Lipa na M-Pesa Online passkey
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"   # or CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=""              # Till number when using Buy Goods (else defaults to the shortcode)
# Secret path segment of the callback URL: ${APP_URL}/api/mpesa/callback/${MPESA_CALLBACK_TOKEN}
MPESA_CALLBACK_TOKEN=""
# Optional comma-separated Safaricom callback IPs to allow (leave empty to skip the IP check)
MPESA_ALLOWED_IPS=""
# Success callbacks are re-verified with STK Query before unlocking. Set "false" only for debugging.
MPESA_VERIFY_CALLBACKS="true"

# ─── Email (Resend) — without a key, emails are logged only ───
RESEND_API_KEY=""
EMAIL_FROM="HomeVista Ke <no-reply@homevista.co.ke>"
CONTACT_INBOX="hello@homevista.co.ke"

# ─── SMS (Africa's Talking) — without a key, SMS are logged only ───
AT_USERNAME=""                # "sandbox" for testing
AT_API_KEY=""
AT_SENDER_ID=""               # approved alphanumeric sender ID, e.g. HOMEVISTA

# ─── Google sign-in (optional; button hidden when unset) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Object storage (optional; defaults to ./storage on local disk) ───
# Any S3-compatible service: AWS S3, Cloudflare R2, DigitalOcean Spaces…
S3_BUCKET=""                  # public-read bucket for property photos, logos, banners
S3_PRIVATE_BUCKET=""          # PRIVATE bucket for KYC documents (strongly recommended)
S3_REGION="auto"
S3_ENDPOINT=""                # e.g. https://<account>.r2.cloudflarestorage.com (blank for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""              # public base URL of S3_BUCKET, e.g. https://media.homevista.co.ke
